        "env": {
          "PATH": "${env:HOME}/.local/bin:${env:PATH}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "npm: test:coverage",
      "type": "npm",
      "script": "test:coverage",
      "group": "test",
      "problemMatcher": [],
      "options": {
        "env": {
          "PATH": "${env:HOME}/.local/bin:${env:PATH}"
        }
      }
    },
    {
      "label": "npm: typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": [],
      "options": {
        "env": {
          "PATH": "${env:HOME}/.local/bin:${env:PATH}"
        }
      }
    },
    {
      "label": "npm: build",
      "type": "npm",
      "script": "build",
      "problemMatcher": [],
      "options": {
        "env": {
          "PATH": "${env:HOME}/.local/bin:${env:PATH}"
        }
      }
    }
  ]
}
